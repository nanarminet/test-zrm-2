# Copiez ce fichier en « secrets.toml » (même dossier) : il est ignoré par git.
# Streamlit ne lit ce fichier que si vous lancez l'application DEPUIS le dossier poc_activites_ia.
# Variante conseillée : variables d'environnement (voir le README).

OLLAMA_API_KEY = "votre_clé_ollama"

# Pour passer à Mistral : supprimez la ligne OLLAMA_API_KEY ci-dessus et décommentez celle-ci.
# MISTRAL_API_KEY = "votre_clé_mistral"

# Si les deux clés sont présentes, il faut préciser le fournisseur :
# LLM_PROVIDER = "mistral"      # ollama | mistral | mock (mock = aucune IA, pour essayer l'interface)

# Facultatif :
# LLM_MODEL = "mistral-small-2603"
# LLM_ENVOYER_IMAGE = "non"     # ne pas joindre l'image choisie aux appels (mots et souhait seuls)
